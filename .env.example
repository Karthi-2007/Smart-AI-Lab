# ============================================================
# SmartLab AI — Production Environment Variables Template
# Copy this file to .env and replace placeholder values
# ============================================================

# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartlab
AUTH_DB_NAME=auth_db
DB_USERNAME=root
DB_PASSWORD=

# Full JDBC URLs (Optional override)
DB_URL=jdbc:mysql://localhost:3306/smartlab?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
AUTH_DB_URL=jdbc:mysql://localhost:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Hibernate Schema Mode
HIBERNATE_DDL_AUTO=update

# Security & JWT (Must be identical across Auth Service and SmartLab Service)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Google Gemini API Key (Backend AI Analytics & Chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Gmail SMTP Email Notification Credentials
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional SMS Gateway (Twilio / Simulator)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Service URLs (Used for Docker / Cloud deployment)
AUTH_SERVICE_URL=http://localhost:8081
SMARTLAB_SERVICE_URL=http://localhost:8082
API_GATEWAY_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
